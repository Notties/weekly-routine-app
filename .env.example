# Supabase cloud sync (ออปชัน) — ไม่ใส่ = ใช้งานออฟไลน์ปกติ
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจาก Supabase project (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=

# ใช้คีย์ใหม่ (sb_publishable_...) หรือ anon key เดิม อย่างใดอย่างหนึ่ง
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
